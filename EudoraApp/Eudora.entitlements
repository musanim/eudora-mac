<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the hardened runtime send Apple Events, which BrowserOpener uses to
	     open a link in a new Chrome window centred on the primary display.
	     Without it the script fails with -1743 and macOS never asks. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
